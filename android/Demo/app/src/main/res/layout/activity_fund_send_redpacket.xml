<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/theme_bg"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:background="@drawable/shape_card" android:orientation="vertical" android:padding="16dp"><TextView android:id="@+id/tvTarget" style="@style/XianliaoBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" /></LinearLayout><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="总金额（元）" /><EditText android:id="@+id/etAmount" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="例如 10.00" android:inputType="numberDecimal" /><TextView android:id="@+id/tvBalance" style="@style/XianliaoHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="目前余额：加载中…" /><TextView android:id="@+id/tvCountLabel" style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="红包个数（群红包）" /><EditText android:id="@+id/etCount" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="例如 10" android:inputType="number" /><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="祝福语（可选，最多 200 字）" /><EditText android:id="@+id/etGreeting" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="恭喜发财" /><Button android:id="@+id/btnSend" style="@style/XianliaoButtonPrimary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="塞钱进红包" /><Button android:id="@+id/btnResendMsg" style="@style/XianliaoButtonSecondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="重新发送红包消息" android:visibility="gone" /><TextView android:id="@+id/tvResult" style="@style/XianliaoBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" /><TextView style="@style/XianliaoHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="发包时金额从可用余额冻结；消息体只放 packetId，不放金额，领取金额以服务端为准。群红包发送前会拉取群成员列表作为领取集合。" /></LinearLayout></ScrollView></layout>
