<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/theme_bg"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:layout_marginBottom="8dp" android:text="提现方式" /><LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/shape_input" android:gravity="center_vertical" android:orientation="horizontal"><Spinner android:id="@+id/spMethod" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:paddingLeft="14dp" /><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="12dp" android:src="@drawable/ic_xl_chevron_right" android:tint="@color/txt_shallow" /></LinearLayout><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="提现金额（元）" /><EditText android:id="@+id/etAmount" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="例如 100.00" android:inputType="numberDecimal" /><TextView android:id="@+id/tvBalance" style="@style/XianliaoHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="目前余额：加载中…" /><Button android:id="@+id/btnSubmit" style="@style/XianliaoButtonPrimary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="提交提现" /><TextView android:id="@+id/tvResult" style="@style/XianliaoBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" /><Button android:id="@+id/btnRecords" style="@style/XianliaoButtonGhost" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="提现记录" /><TextView style="@style/XianliaoHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="提交即冻结金额与手续费；后续审核与打款在管理端进行，App 不直接打款。实际手续费与到账金额以提交后服务端返回为准。" /></LinearLayout></ScrollView></layout>
