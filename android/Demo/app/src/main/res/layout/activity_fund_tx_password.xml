<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/theme_bg"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:background="@drawable/shape_card" android:orientation="vertical" android:padding="16dp"><TextView android:id="@+id/tvStatus" style="@style/XianliaoBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="加载中…" /></LinearLayout>
<!-- 设置区：仅未设置交易密码时显示 -->
<LinearLayout android:id="@+id/groupSet" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView style="@style/XianliaoSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="设置交易密码" /><TextView style="@style/XianliaoHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="6 位数字，两次一致" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/shape_card" android:orientation="vertical" android:padding="16dp"><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:layout_marginBottom="8dp" android:text="新交易密码" /><EditText android:id="@+id/etNew1" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="新交易密码（6 位数字）" android:inputType="numberPassword" /><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="再次输入新交易密码" /><EditText android:id="@+id/etNew2" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="再次输入新交易密码" android:inputType="numberPassword" /><Button android:id="@+id/btnSet" style="@style/XianliaoButtonPrimary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="设置交易密码" /></LinearLayout></LinearLayout>
<!-- 修改区：仅已设置交易密码时显示；自带旧密码+新密码+再次输入，不依赖上方设置区 -->
<LinearLayout android:id="@+id/groupChange" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView style="@style/XianliaoSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="修改交易密码" /><TextView style="@style/XianliaoHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="须验证旧密码；新密码请在下方输入" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/shape_card" android:orientation="vertical" android:padding="16dp"><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:layout_marginBottom="8dp" android:text="旧交易密码" /><EditText android:id="@+id/etOld" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="旧交易密码（6 位数字）" android:inputType="numberPassword" /><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="新交易密码" /><EditText android:id="@+id/etNewChange1" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="新交易密码（6 位数字）" android:inputType="numberPassword" /><TextView style="@style/XianliaoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="再次输入新交易密码" /><EditText android:id="@+id/etNewChange2" style="@style/XianliaoInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="再次输入新交易密码" android:inputType="numberPassword" /><Button android:id="@+id/btnChange" style="@style/XianliaoButtonSecondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="修改交易密码" /></LinearLayout></LinearLayout>
<TextView style="@style/XianliaoHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="交易密码与登录密码区分、哈希保存；连续输错 5 次锁定 30 分钟。密码不落盘、不进日志。" /></LinearLayout></ScrollView></layout>
