<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ui.ForwardToActivity">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">


            <com.yanzhenjie.recyclerview.widget.StickyNestedScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <com.yanzhenjie.recyclerview.SwipeRecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/card_bg"
                    android:overScrollMode="never" />

            </com.yanzhenjie.recyclerview.widget.StickyNestedScrollView>

            <com.mao.sortletterlib.SortLetterView
                android:id="@+id/sort_view"
                android:background="@color/sort_bg"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                app:iconHeight="49dp"
                app:iconWidth="58dp"
                app:leftBigText="26sp"
                app:letterColor="@color/sort_text"
                app:letterSize="15sp"
                app:paddingRight="20dp"
                app:selectBackgroundColor="@color/sort_select_bg"
                app:selectLetterColor="@color/sort_select_text"
                app:selectbigtTextColor="@color/sort_text" />
        </RelativeLayout>
    </LinearLayout>
</layout>
