<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框 emoji 面板：由 BottomInputCote 托管在 layout_input_cote 的 fragment_container 里，
     与 + 面板共用同一容器、同一套切换逻辑；面板固定 280dp 高，不随键盘高度变化。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:background="@color/theme_bg2"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/xlEmojiGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="常用表情"
            android:textColor="@color/txt_shallow"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/xlEmojiDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⌫"
            android:textColor="@color/txt_shallow"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
